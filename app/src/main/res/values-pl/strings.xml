    <!-- Onboarding -->
    <string name="onboarding_slide1_caption">Licznik UnderPressure</string>
    <string name="onboarding_slide1_description">UnderPressure to prosty i prywatny tracker ciśnienia krwi i tętna, który przechowuje wszystkie dane wyłącznie na telefonie. Bez serwerów, bez zbierania danych, bez reklam, bez opłat.</string>
    <string name="onboarding_slide2_caption">Zaplanowane i dowolne pomiary</string>
    <string name="onboarding_slide2_description">Skonfiguruj do 4 przedziałów czasowych dla zaplanowanych pomiarów lub dodawaj pomiary w dowolnym momencie za pomocą przycisku +. Przełączaj się między widokami Zaplanowane i Wszystkie, aby zobaczyć swoje dane.</string>
    <string name="onboarding_slide3_caption">Wykres pomiarów</string>
    <string name="onboarding_slide3_description">Możesz przeglądać i udostępniać wykresy pomiarów. Skonfiguruj wykresy dla potrzebnych miejsc i danych.</string>
    <string name="onboarding_slide4_caption">Udostępnij dane</string>
    <string name="onboarding_slide4_description">Możesz udostępniać dane, jeśli chcesz. W każdym innym przypadku dane nie opuszczą Twojego telefonu. Nie zbieramy również żadnych danych telemetrycznych ani logów.</string>
    <string name="onboarding_slide5_caption">Wytyczne klasyfikacji</string>
    <string name="onboarding_slide5_description">UnderPressure obsługuje wytyczne klasyfikacji ACC/AHA oraz ESC/ESH. Przełączaj się między nimi w ustawieniach, aby dopasować je do zaleceń lekarza.</string>
    <string name="button_onboarding_close">Zaczynamy</string>

    <!-- Guidance Popup -->
    <string name="guidance_title">Wydaje się, że to nie jest twój czas pomiaru</string>
    <string name="guidance_message">Wydaje się, że próbujesz dodać pomiar w niewłaściwym czasie. UnderPressure korzysta ze stałych przedziałów czasowych, aby pomiary były bardziej precyzyjne i regularne. Czy chcesz ustawić czas dla slotu %1$d na %2$s i dodać pomiar już teraz?\n\nZawsze możesz zmienić czas slotu w Ustawieniach lub po prostu dotykając czasu w nagłówku tabeli.</string>
    <string name="hint_edit_slot">Możesz zmienić wartość slotu %1$d, dotykając go.</string>
