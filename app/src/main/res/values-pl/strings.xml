    <!-- Onboarding -->
    <string name="onboarding_slide1_caption">Licznik UnderPressure</string>
    <string name="onboarding_slide1_description">UnderPressure to prosty i prywatny tracker ciśnienia krwi i tętna, który przechowuje wszystkie dane wyłącznie na telefonie. Bez serwerów, bez zbierania danych, bez reklam, bez opłat.</string>
    <string name="onboarding_slide2_caption">Do 4 miejsc każdego dnia</string>
    <string name="onboarding_slide2_description">Możesz dodać do 4 przedziałów czasowych na pomiar. Wprowadzanie danych jest możliwe w ciągu +/- 15 minut od każdego z nich. Przedziały czasowe możesz skonfigurować w Ustawieniach.</string>
    <string name="onboarding_slide3_caption">Wykres pomiarów</string>
    <string name="onboarding_slide3_description">Możesz przeglądać i udostępniać wykresy pomiarów. Skonfiguruj wykresy dla potrzebnych miejsc i danych.</string>
    <string name="onboarding_slide4_caption">Udostępnij dane</string>
    <string name="onboarding_slide4_description">Możesz udostępniać dane, jeśli chcesz. W każdym innym przypadku dane nie opuszczą Twojego telefonu. Nie zbieramy również żadnych danych telemetrycznych ani logów.</string>
    <string name="button_onboarding_close">Zaczynamy</string>

    <!-- Guidance Popup -->
    <string name="guidance_title">Wydaje się, że to nie jest twój czas pomiaru</string>
    <string name="guidance_message">Wydaje się, że próbujesz dodać pomiar w niewłaściwym czasie. UnderPressure korzysta ze stałych przedziałów czasowych, aby pomiary były bardziej precyzyjne i regularne. Czy chcesz ustawić czas dla slotu %1$d na %2$s i dodać pomiar już teraz?</string>
    <string name="hint_edit_slot">Możesz zmienić wartość slotu %1$d, dotykając go.</string>
    <string name="hint_cannot_create_slot">Nie można teraz utworzyć slotu. Musi on być oddalony o co najmniej 30 minut od sąsiednich slotów. Użyj następnego slotu o %1$s.</string>
