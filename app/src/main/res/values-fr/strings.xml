    <!-- Blood Pressure Info Dialog -->
    <string name="dialog_title_bp_info">Information sur la pression artérielle</string>
    <string name="bp_info_what_is_title">Qu\'est-ce que la pression artérielle ?</string>
    <string name="bp_info_what_is_desc">La force du sang poussant contre les parois des artères. Elle est mesurée avec deux nombres :</string>
    <string name="bp_info_systolic_title">Systolique (Haut/Premier)</string>
    <string name="bp_info_systolic_desc">Pression lorsque votre cœur bat.</string>
    <string name="bp_info_diastolic_title">Diastolique (Bas/Second)</string>
    <string name="bp_info_diastolic_desc">Pression lorsque votre cœur se repose entre les battements.</string>
    <string name="bp_info_why_matters_title">Pourquoi c\'est important</string>
    <string name="bp_info_why_matters_desc">Les deux nombres sont critiques. Une pression élevée constante peut endommager les artères au fil du temps, entraînant des maladies cardiaques ou un AVC.</string>
    <string name="bp_info_silent_killer_title">Le « tueur silencieux »</string>
    <string name="bp_info_silent_killer_desc">L\'hypertension n\'a souvent aucun symptôme. Un suivi régulier est le seul moyen de savoir si vos niveaux sont sains.</string>
    <string name="bp_info_when_to_see_doctor_title">Quand consulter un médecin</string>
    <string name="bp_info_when_to_see_doctor_desc">Si vos lectures sont constamment au-dessus de votre plage cible (ex. 130/80 ou 140/90).</string>
    <string name="bp_info_emergency_title">Urgence</string>
    <string name="bp_info_emergency_desc">Si vous atteignez une « crise hypertensive » (180/120 ou plus), attendez 5 minutes et refaites le test. Si cela reste élevé, contactez immédiatement les services médicaux.</string>
