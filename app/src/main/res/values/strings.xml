    <!-- Blood Pressure Info Dialog -->
    <string name="dialog_title_bp_info">Blood Pressure Information</string>
    <string name="bp_info_what_is_title">What is Blood Pressure?</string>
    <string name="bp_info_what_is_desc">The force of blood pushing against artery walls. It is measured with two numbers:</string>
    <string name="bp_info_systolic_title">Systolic (Top/First)</string>
    <string name="bp_info_systolic_desc">Pressure when your heart beats.</string>
    <string name="bp_info_diastolic_title">Diastolic (Bottom/Second)</string>
    <string name="bp_info_diastolic_desc">Pressure when your heart rests between beats.</string>
    <string name="bp_info_why_matters_title">Why it Matters</string>
    <string name="bp_info_why_matters_desc">Both numbers are critical. Consistent high pressure can damage arteries over time, leading to heart disease or stroke.</string>
    <string name="bp_info_silent_killer_title">The \"Silent Killer\"</string>
    <string name="bp_info_silent_killer_desc">Hypertension often has no symptoms. Regular tracking is the only way to know if your levels are healthy.</string>
    <string name="bp_info_when_to_see_doctor_title">When to see a Doctor</string>
    <string name="bp_info_when_to_see_doctor_desc">If your readings are consistently above your target range (e.g., 130/80 or 140/90).</string>
    <string name="bp_info_emergency_title">Emergency</string>
    <string name="bp_info_emergency_desc">If you hit a \"Hypertensive Crisis\" (180/120 or higher), wait 5 minutes and re-test. If it stays high, contact medical services immediately.</string>
