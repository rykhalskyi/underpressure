    <!-- Onboarding -->
    <string name="onboarding_slide1_caption">UnderPressure tracker</string>
    <string name="onboarding_slide1_description">Underpressure is a simple and private blood pressure and pulse tracker that keeps all your data only on your phone. No servers, no data collection, no ads, no payments.</string>
    <string name="onboarding_slide2_caption">Scheduled &amp; Anytime Readings</string>
    <string name="onboarding_slide2_description">Set up to 4 time slots for scheduled readings, or log readings anytime using the + button. Switch between Scheduled and All views to see your data.</string>
    <string name="onboarding_slide3_caption">Measurements Chart</string>
    <string name="onboarding_slide3_description">You can see and share measurements charts. Configure charts for slots and data you need.</string>
    <string name="onboarding_slide4_caption">Share Data</string>
    <string name="onboarding_slide4_description">You can share data if you want to. In any other cases your data won\'t leave your phone. We don\'t collect any telemetry or logs too.</string>
    <string name="onboarding_slide5_caption">Classification Guidelines</string>
    <string name="onboarding_slide5_description">UnderPressure supports both ACC/AHA and ESC/ESH classification guidelines. Switch between them in settings to match your doctor\'s advice.</string>
    <string name="onboarding_slide6_caption">Custom Trackers</string>
    <string name="onboarding_slide6_description">Add custom trackers like weight, mood, or medication to your measurements. Track more than just blood pressure to gain deeper insights into your health.</string>
    <string name="button_onboarding_close">Get Started</string>

