    <!-- Onboarding -->
    <string name="onboarding_slide0_caption">Disclaimer</string>
    <string name="onboarding_slide0_description">This app is a digital logbook for tracking stress and physical tension trends and is intended for informational and educational purposes only. It is not a substitute for professional guidance, assessment, or treatment. It does not manage health conditions, or alter routines.</string>
    <string name="onboarding_slide1_caption">UnderPressure tracker</string>
    <string name="onboarding_slide1_description">Underpressure is a simple and private tension and rhythm tracker that keeps all your data only on your phone. No servers, no data collection, no ads, no payments.</string>
    <string name="onboarding_slide2_caption">Scheduled &amp; Flexible Readings</string>
    <string name="onboarding_slide2_description">Set up to 4 time slots for scheduled logs, or log readings anytime using the + button. Switch between Scheduled and All views to see your data.</string>
    <string name="onboarding_slide3_caption">Measurements Chart</string>
    <string name="onboarding_slide3_description">You can see and share tension charts. Configure charts for slots and data you need.</string>
    <string name="onboarding_slide4_caption">Share Data</string>
    <string name="onboarding_slide4_description">You can share data if you want to. In any other cases your data won\'t leave your phone. We don\'t collect any telemetry or logs too.</string>
    <string name="onboarding_slide5_caption">Tension Standards</string>
    <string name="onboarding_slide5_description">UnderPressure supports multiple wellness tension profiles. Switch between them in settings to match your wellness goals.</string>
    <string name="onboarding_slide6_caption">Custom Trackers</string>
    <string name="onboarding_slide6_description">Add custom trackers like weight, mood, or routine checks to your metrics. Track more than just one value to gain deeper insights into your wellness.</string>
    <string name="button_onboarding_close">Get Started</string>

