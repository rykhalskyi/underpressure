    <!-- Blood Pressure Info Dialog -->
    <string name="dialog_title_bp_info">Información sobre presión arterial</string>
    <string name="bp_info_what_is_title">¿Qué es la presión arterial?</string>
    <string name="bp_info_what_is_desc">La fuerza de la sangre empujando contra las paredes de las arterias. Se mide con dos números:</string>
    <string name="bp_info_systolic_title">Sistólica (superior/primero)</string>
    <string name="bp_info_systolic_desc">Presión cuando late tu corazón.</string>
    <string name="bp_info_diastolic_title">Diastólica (inferior/segundo)</string>
    <string name="bp_info_diastolic_desc">Presión cuando tu corazón descansa entre latidos.</string>
    <string name="bp_info_why_matters_title">Por qué es importante</string>
    <string name="bp_info_why_matters_desc">Ambos números son críticos. Una presión alta constante puede dañar las arterias con el tiempo, lo que lleva a enfermedades cardíacas o un derrame cerebral.</string>
    <string name="bp_info_silent_killer_title">El «asesino silencioso»</string>
    <string name="bp_info_silent_killer_desc">La hipertensión a menudo no presenta síntomas. El seguimiento regular es la única forma de saber si tus niveles son saludables.</string>
    <string name="bp_info_when_to_see_doctor_title">Cuándo ver a un médico</string>
    <string name="bp_info_when_to_see_doctor_desc">Si tus lecturas están constantemente por encima de tu rango objetivo (p. ej., 130/80 o 140/90).</string>
    <string name="bp_info_emergency_title">Emergencia</string>
    <string name="bp_info_emergency_desc">Si alcanzas una «crisis hipertensiva» (180/120 o superior), espera 5 minutos y vuelve a realizar la prueba. Si sigue siendo alta, contacta inmediatamente con los servicios médicos.</string>
